# ==============================================================================
# mooc-clone Monorepo Master .gitignore
# Covers: Monorepo Root, client/ (React + Vite + TS), server/ (Spring Boot + Maven)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System & Local Environment Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 2. IDEs & Code Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/
*.code-workspace

# IntelliJ IDEA / WebStorm / Android Studio
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse / Spring Tool Suite (STS)
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Editor temporary/swap files
*.swp
*.swo
*.swn
*~
*.bak

# ------------------------------------------------------------------------------
# 3. AI Coding Assistants & Local Agent Sessions
# Root .agents/ and skills-lock.json are COMMITTED to share skills & rules with team.
# Ignore local sessions, user caches, and duplicate subfolder copies.
# ------------------------------------------------------------------------------
.gemini/
.claude/
CLAUDE.md
.copilot/
client/.agents/

# ------------------------------------------------------------------------------
# 4. Logs, Runtime & Debugging
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# 5. Environment Variables & Secrets (CRITICAL SECURITY)
# Whitelist template/example files
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.*
!.env.example
!.env.*.example
!.env.liff-mock.example
!.env.docker.example

# Spring Boot secrets & properties
**/application-secret.properties
**/application-secret.yml
**/application-secret.yaml
**/application-local.properties
**/application-local.yml
**/application-local.yaml

# Keystores, Certificates & Private Keys
*.pem
*.key
*.p12
*.jks
*.keystore
*.crt
*.cert

# Database backups & dumps
*.sql
!server/online_exam_schema.sql
*.dump
server/backups/
backups/

# User uploads & ephemeral storage
uploads/
server/uploads/
client/uploads/

# ------------------------------------------------------------------------------
# 6. Frontend / Node.js (client/)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml

# Build outputs & caches
dist/
build/
.next/
.nuxt/
.output/
.vite/
.turbo/
.parcel-cache/
.cache/
.eslintcache
.stylelintcache
.prettiercache
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# 7. Backend / Java & Maven (server/)
# ------------------------------------------------------------------------------
server/HELP.md
target/
*.class
*.jar
*.war
*.ear
*.nar

# Maven wrapper and source targets
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/

# ------------------------------------------------------------------------------
# 8. Project Artifacts, Diagram Pictures & Tooling Exports
# ------------------------------------------------------------------------------
# PlantUML generated output
docs/VI/Diagram/picture/*.png
docs/VI/Diagram/picture/*.svg
!docs/VI/Diagram/picture/.gitkeep

# Postman exports
docs/Design/API/postman_collections/
docs/Design/API/*.postman_collection.json

# Design System Kit & templates
design-system-kit/
client/design-system-kit/
templates/*
