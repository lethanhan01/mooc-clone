{
  "name": "@mooc/client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "type-check": "tsc --noEmit",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,css}\"",
    "audit": "node scripts/audit-conventions.mjs",
    "audit:summary": "node scripts/audit-conventions.mjs --summary",
    "audit:strict": "node scripts/audit-conventions.mjs --strict",
    "audit:ratchet": "node scripts/audit-conventions.mjs --ratchet",
    "audit:baseline": "node scripts/audit-conventions.mjs --generate-baseline",
    "audit:update-baseline": "node scripts/audit-conventions.mjs --update-baseline",
    "audit:rules": "node scripts/audit-conventions.mjs --list-rules",
    "audit:contrast": "node scripts/audit/contrast-check.mjs",
    "audit:deprecated": "node scripts/audit/deprecated-tokens.mjs",
    "audit:html": "node scripts/audit-conventions.mjs --domain=html-semantic",
    "audit:css": "node scripts/audit-conventions.mjs --domain=css-tokens",
    "audit:props": "node scripts/audit-conventions.mjs --domain=react-props",
    "audit:a11y": "node scripts/audit-conventions.mjs --domain=a11y",
    "audit:forms": "node scripts/audit-conventions.mjs --domain=forms",
    "audit:state": "node scripts/audit-conventions.mjs --domain=state",
    "audit:testing": "node scripts/audit-conventions.mjs --domain=testing",
    "audit:arch": "node scripts/audit-conventions.mjs --domain=architecture",
    "audit:security": "node scripts/audit-conventions.mjs --domain=security",
    "measure:styles": "node scripts/audit/measure-styles.mjs",
    "migrate:suggest": "node scripts/audit/migrate-suggest.mjs",
    "migrate:props": "node scripts/audit/props-migrate.mjs",
    "verify:docs": "node scripts/verify-docs-integrity.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.35.1",
    "@tanstack/react-virtual": "^3.14.20",
    "axios": "^1.6.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dompurify": "^3.4.17",
    "emoji-picker-react": "^4.22.2",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.378.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-day-picker": "^8.10.2",
    "react-dom": "^19.0.0",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.4",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^25.0.1",
    "prettier": "^3.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "vitest": "^2.1.9"
  }
}
